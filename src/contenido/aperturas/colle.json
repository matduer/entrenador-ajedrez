{
  "id": "colle",
  "nombre": "Sistema Colle",
  "raiz": "d2d4 d7d5 g1f3 g8f6 e2e3",
  "resumen": "Un sistema para las blancas: peones en c3, d4 y e3, alfil en d3, caballo en d2 y enroque corto. El plan es preparar la ruptura e4, que abre el juego contra el enroque negro, con el alfil de d3 apuntando a h7. Es sólido y fácil de aprender; su punto débil es que el alfil de c1 queda encerrado.",
  "planesBlancas": [
    "Preparar e4 con Cbd2, Te1 y Dc2 o De2.",
    "Ataque contra h7 con el alfil de d3."
  ],
  "planesNegras": [
    "...c5 y ...Cc6 para presionar d4.",
    "Oponer el alfil a d6 y vigilar e5."
  ],
  "estructura": "Cadena c3-d4-e3 de las blancas; el negro con d5 y e6, y ...c5.",
  "rupturas": [
    "e4 de las blancas.",
    "...c5 y ...e5 del negro."
  ],
  "piezas": [
    "Alfil blanco de f1: d3, sobre h7.",
    "Alfil blanco de c1: encerrado detrás de e3; a veces sale por b2 (Colle-Zukertort)."
  ],
  "trampas": [
    {
      "jugadas": "d2d4 d7d5 g1f3 g8f6 e2e3 e7e6 f1d3 f8d6 b1d2 b8d7 e1g1 e8g8 e3e4 d5e4 d2e4 f6e4 d3e4 e6e5 d4e5 d7e5 f3e5 d6e5 e4h7 g8h7 d1h5 h7g8 h5e5",
      "texto": "Si el negro copia las jugadas del blanco (4...Ad6, ...Cbd7, ...0-0) y después de 7.e4 dxe4 8.Cxe4 Cxe4 9.Axe4 busca liberarse con 9...e5?, viene 10.dxe5 Cxe5 11.Cxe5 Axe5 12.Axh7+! Rxh7 13.Dh5+ Rg8 14.Dxe5: el blanco recupera el alfil y gana un peón (Koltanowski)."
    }
  ],
  "notas": {
    "d2d4 d7d5 g1f3 g8f6 e2e3": {
      "porQue": "Sistema Colle: cadena c3-d4-e3, Ad3, Cbd2 y la ruptura e4."
