    "d2d4 d7d5 g1f3 g8f6 e2e3 e7e6 f1d3 c7c5": {
      "porQue": "Ataca d4."
    },
    "d2d4 d7d5 g1f3 g8f6 e2e3 e7e6 f1d3 c7c5 c2c3": {
      "porQue": "Sostiene d4: la cadena típica del Colle."
