      "porQue": "Desarrolla de forma sólida."
    },
    "e2e4 c7c5 g1f3 e7e6 d2d4 c5d4 f3d4 g8f6 b1c3 b8c6 d4b5 f8b4 c1f4": {
      "porQue": "Apunta a c7 y d6, las casillas de entrada del caballo de b5."
    },
    "e2e4 c7c5 g1f3 e7e6 d2d4 c5d4 f3d4 g8f6 b1c3 b8c6 d4b5 f8b4 c1f4 f6e4": {
      "porQue": "Toma el peón de e4 con contraataque."
